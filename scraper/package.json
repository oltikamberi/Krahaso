{
  "name": "krahaso-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Independent scraper worker for Krahaso — writes products and price history into the shared PostgreSQL database.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "scrape:once": "tsx src/run-once.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "bullmq": "^5.56.0",
    "cheerio": "^1.1.0",
    "got": "^14.4.7",
    "ioredis": "^5.6.1",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "playwright": "^1.54.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
